// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum tipoEvento {
  COBBLEMON
  OUTRO
}

model User {
  id             String  @id @default(uuid()) // ID interno do banco
  discordId      String  @unique // ID do Discord (chave única para busca)
  email          String? @unique // Email do usuário (pode ser nulo)
  // Dados de Identificação
  username       String
  globalName     String?
  serverNickName String?

  // URLs de Imagens
  avatarUrl       String?
  serverAvatarUrl String?
  bannerUrl       String?
  serverBannerUrl String?

  // Metadados
  isBot    Boolean @default(false)
  colorHex String? // A cor que o usuário exibe no servidor

  // Datas
  accountCreatedAt DateTime
  joinedServerAt   DateTime?
  premiumSince     DateTime?

  // Campos de Controle do Banco
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relacionamento: Um usuário pode ter vários cargos
  roles Role[]

  // Relacionamento Opcional (?): O usuário pode existir sem ter criado perfil ainda
  profile Profile?

  // Conexões (Steam, etc)
  connections     Connection[]
  contasMinecraft ContaMinecraft[]

  // Posts e Comentários do Feed
  posts    Post[]
  comments Comment[]

  @@map("Membros") // Nome da tabela no banco
}

model Role {
  id        String @id @default(uuid())
  discordId String @unique // Importante para o "connect" funcionar

  name          String
  colorHex      String?
  position      Int
  permissions   String // Armazenado como String (BigInt convertido)
  isManaged     Boolean @default(false)
  isMentionable Boolean @default(false)
  isHoist       Boolean @default(false)

  // Relacionamento: Um cargo pode pertencer a vários usuários
  membros User[]

  @@map("Cargos") // Nome da tabela no banco
}

model Profile {
  id String @id @default(uuid())

  // Campos que o usuário edita
  bio                String?   @db.Text // "Sobre Mim"
  socialLinks        Json?
  birthDate          DateTime?
  AvatarSite         String? // Ex: "dark", "dracula" (preferência do site)
  BannerSite         String?
  steamFavoriteGames Json?

  // A chave estrangeira que liga ao Membro
  userId String @unique // @unique garante que 1 Membro só tem 1 Perfil
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Campos de Controle do Banco
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("Perfis") // Nome da tabela no banco
}

model Connection {
  id           String  @id @default(uuid())
  provider     String // "steam", "spotify"
  providerId   String
  refreshToken String?

  userId String
  user   User   @relation(fields: [userId], references: [id])

  @@unique([provider, providerId])
  @@map("Conexoes") // Nome da tabela no banco
}

model OharaEventos {
  id               String     @id @default(uuid())
  nomeEvento       String     @unique
  tipoEvento       tipoEvento
  descricao        String
  dataInicio       DateTime
  dataEncerramento DateTime
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  pokemonsCapturados PokemonsCapturados[]

  // Relação com anúncios e postagens do evento
  posts Post[]

  @@map("OharaEventos") // Nome da tabela no banco
}

model PokemonsCapturados {
  id          Int            @id @default(autoincrement())
  eventoId    String?
  playerUuid  String
  conta       ContaMinecraft @relation(fields: [playerUuid], references: [uuid], onDelete: Cascade)
  evento      OharaEventos?  @relation(fields: [eventoId], references: [id], onDelete: Cascade)
  pokemon     String
  level       Int
  pokebola    String
  tipos       String[]
  capturadoEm DateTime       @default(now())

  @@map("PokemonsCapturados")
}

model ContaMinecraft {
  uuid      String               @id
  userId    String?              @unique
  membro    User?                @relation(fields: [userId], references: [id], onDelete: Cascade)
  nickAtual String
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt
  pokemons  PokemonsCapturados[]

  @@map("ContasMinecraft")
}

model Post {
  id      String @id @default(uuid())
  content String @db.Text // Texto rico gerado pelo editor
  media   Json? // Arrays de links para imagens/gifs

  authorId String
  author   User   @relation(fields: [authorId], references: [id], onDelete: Cascade)

  eventoId String?
  evento   OharaEventos? @relation(fields: [eventoId], references: [id], onDelete: Cascade)

  comentarios Comment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("Posts")
}

model Comment {
  id      String @id @default(uuid())
  content String @db.Text
  media   Json? // Imagens ou gifs anexados ao comentário

  postId String
  post   Post   @relation(fields: [postId], references: [id], onDelete: Cascade)

  authorId String
  author   User   @relation(fields: [authorId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("Comentarios")
}
